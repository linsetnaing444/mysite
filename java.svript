document.getElementById('SearchBar').addEventListener('keyup',>
let query = this.value;
console.log("မင်းရှာ‌ေနတာက " + query);

function filterCommands() {
    let input = document.getElementById("searchbar").value.toLowerCase();
    let table = document.getElementById("commandTable");
    let rows = table.getElementsByClassName("command-row");

    for (let i = 0; i < rows.length; i++) {
        let commandText = rows[i].getElementsByTagName("td")[0].innerText.toLowerCase();
        
        if (commandText.includes(input)) {
            rows[i].style.display = ""; 
        } else {
            rows[i].style.display = "none"; 
        }
    }
}


